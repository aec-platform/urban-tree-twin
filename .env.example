# ---- Shared ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (PostgreSQL + PostGIS) ----
POSTGRES_USER=utt
POSTGRES_PASSWORD=utt_dev_password
POSTGRES_DB=urban_tree_twin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://utt:utt_dev_password@localhost:5432/urban_tree_twin?schema=public

# ---- Redis (cache + BullMQ queues) ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO / S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=utt-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- API ----
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-in-production-please-use-32-bytes-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PASSWORD_PEPPER=change-me-also

# ---- Health scoring inference (optional external model gateway) ----
INFERENCE_URL=http://localhost:8000
INFERENCE_API_KEY=

# ---- Weather provider (typhoon / wind forecasting) ----
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEFAULT_LAT=21.0285
NEXT_PUBLIC_DEFAULT_LNG=105.8542
